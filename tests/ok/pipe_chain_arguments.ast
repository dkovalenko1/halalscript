Program
  Dua add(dirham x, dirham y) -> dirham
    Param x dirham (immutable)
    Param y dirham (immutable)
    Block yalla
      Ameen
        BinOp +
          Var x
          Var y
  Dua scale(dinar x, dirham by) -> dinar
    Param x dinar (immutable)
    Param by dirham (immutable)
    Block yalla
      Ameen
        BinOp *
          Var x
          Var by
  Dua big(dinar x) -> fatwa
    Param x dinar (immutable)
