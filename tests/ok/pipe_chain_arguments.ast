      Ameen
        BinOp >
          Var x
          Int 1000
  Bayan
    Call add (2 arguments, pipe stage 1)
      BinOp +
        Int 2
        Int 3
      Int 10
  Decl wide dinar bismillah (immutable)
    Call scale (2 arguments, pipe stage 2)
      Call add (2 arguments, pipe stage 1)
        Int 1000000
        Int 1
      Int 5000
  Bayan
    Var wide
  Bayan
    BinOp ==
