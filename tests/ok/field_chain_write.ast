Program
  Diwan Point yalla
    Field x dirham inshallah (mutable)
    Field y dirham inshallah (mutable)
    Dua d2() -> dirham (member of Point)
      Block yalla
        Ameen
          BinOp +
            BinOp *
              Var x
              Var x
            BinOp *
              Var y
              Var y
    Dua shift(dirham dx) -> dirham (member of Point)
      Param dx dirham (immutable)
      Block yalla
        Assign x
          BinOp +
            Var x
            Var dx
        Ameen
          Var x
  Diwan Circle yalla
    Field center Point inshallah (mutable)
    Field radius dirham inshallah (mutable)
  Decl c Circle inshallah (mutable)
    New Circle (2 values)
      New Point (2 values)
        Int 3
        Int 4
      Int 2
  Assign c.center.y
    Int 0
  Assign c.radius
    BinOp *
      Field c.radius
      Int 10
  Decl moved dirham bismillah (immutable)
    MemberCall shift on c.center (1 argument)
      Int 2
  Bayan
    MemberCall d2 on c.center (0 arguments)
  Assign c.center
    New Point (2 values)
      Int 1
      Int 1
  Bayan
    Var c
  Ameen
    Var moved
