{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HalalScript",
  "scopeName": "source.halalscript",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#greeting" },
    { "include": "#diwan-header" },
    { "include": "#dua-header" },
    { "include": "#parameter" },
    { "include": "#declaration" },
    { "include": "#keywords" },
    { "include": "#literals" },
    { "include": "#member" },
    { "include": "#call" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifier" }
  ],
  "repository": {
    "comment": {
      "match": "(#).*$",
      "name": "comment.line.number-sign.halalscript",
      "captures": {
        "1": { "name": "punctuation.definition.comment.halalscript" }
      }
    },
    "string": {
      "comment": "a string literal ends on its line; there are no escape sequences",
      "patterns": [
        {
          "match": "\"[^\"\\n]*\"",
          "name": "string.quoted.double.halalscript"
        },
        {
          "match": "\"[^\"\\n]*$",
          "name": "invalid.illegal.unclosed-string.halalscript"
        }
      ]
    },
    "greeting": {
      "match": "\\b(assalamu)\\s+(alaikum)\\b",
      "name": "meta.greeting.halalscript",
      "captures": {
        "1": { "name": "keyword.other.greeting.halalscript" },
        "2": { "name": "keyword.other.greeting.halalscript" }
      }
    },
    "type": {
      "comment": "a coin or a fatwa, or the name of a diwan",
      "patterns": [
        {
          "match": "\\b(dirham|dinar|fatwa)\\b",
          "name": "storage.type.halalscript"
        },
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
          "name": "entity.name.type.diwan.halalscript"
        }
      ]
    },
    "diwan-header": {
      "match": "\\b(diwan)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "storage.type.diwan.halalscript" },
        "2": { "name": "entity.name.type.diwan.halalscript" }
      }
    },
    "dua-header": {
      "match": "\\b(dua)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "storage.type.function.dua.halalscript" },
        "2": { "patterns": [{ "include": "#type" }] },
        "3": { "name": "entity.name.function.halalscript" }
      }
    },
    "parameter": {
      "comment": "<type> <name> right after '(' or ',' and before ',' or ')': a parameter of a dua",
      "match": "(?<=[(,])\\s*(?!la\\b)([A-Za-z_][A-Za-z0-9_]*)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*[,)])",
      "captures": {
        "1": { "patterns": [{ "include": "#type" }] },
        "2": { "name": "variable.parameter.halalscript" }
      }
    },
    "declaration": {
      "comment": "wallahi|bismillah|inshallah <type> <name>: a variable, or a field when no ':=' follows",
      "patterns": [
        {
          "match": "\\b(wallahi)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.modifier.constant.halalscript" },
            "2": { "patterns": [{ "include": "#type" }] },
            "3": { "name": "variable.other.constant.declaration.halalscript" }
          }
        },
        {
          "match": "\\b(bismillah|inshallah)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.modifier.halalscript" },
            "2": { "patterns": [{ "include": "#type" }] },
            "3": { "name": "variable.other.declaration.halalscript" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\bwallahi\\b",
          "name": "storage.modifier.constant.halalscript"
        },
        {
          "match": "\\b(bismillah|inshallah)\\b",
          "name": "storage.modifier.halalscript"
        },
        {
          "match": "\\b(dirham|dinar|fatwa)\\b",
          "name": "storage.type.halalscript"
        },
        {
          "match": "\\bdiwan\\b",
          "name": "storage.type.diwan.halalscript"
        },
        {
          "match": "\\bdua\\b",
          "name": "storage.type.function.dua.halalscript"
        },
        {
          "match": "\\b(istikhara|qadarallah|ma_dama)\\b",
          "name": "keyword.control.conditional.halalscript"
        },
        {
          "match": "\\b(yalla|khalas)\\b",
          "name": "keyword.control.block.halalscript"
        },
        {
          "match": "\\bameen\\b",
          "name": "keyword.control.exit.halalscript"
        },
        {
          "match": "\\b(sual|bayan)\\b",
          "name": "support.function.builtin.halalscript"
        },
        {
          "match": "\\bla\\b",
          "name": "keyword.operator.logical.halalscript"
        },
        {
          "match": "\\b(assalamu|alaikum)\\b",
          "name": "keyword.other.greeting.halalscript"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "match": "\\b(halal|haram)\\b",
          "name": "constant.language.boolean.halalscript"
        },
        {
          "match": "\\b[0-9]+\\b",
          "name": "constant.numeric.decimal.halalscript"
        },
        {
          "match": "[\\x{0660}-\\x{0669}]+",
          "name": "constant.numeric.decimal.arabic.halalscript"
        }
      ]
    },
    "member": {
      "comment": ".name( is a member dua; .name otherwise is a field",
      "patterns": [
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.halalscript" },
            "2": { "name": "entity.name.function.member.halalscript" }
          }
        },
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.halalscript" },
            "2": { "name": "variable.other.property.halalscript" }
          }
        }
      ]
    },
    "call": {
      "comment": "name( is a call of a dua, or Point( a new object; the grammar cannot tell them apart",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.halalscript" }
      }
    },
    "operators": {
      "patterns": [
        {
          "match": ":=",
          "name": "keyword.operator.assignment.halalscript"
        },
        {
          "match": "==|!=",
          "name": "keyword.operator.comparison.halalscript"
        },
        {
          "match": "[+\\-*]",
          "name": "keyword.operator.arithmetic.halalscript"
        },
        {
          "match": "[=!:]",
          "name": "invalid.illegal.operator.halalscript"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[{}]",
          "name": "punctuation.section.block.halalscript"
        },
        {
          "match": "[()]",
          "name": "punctuation.section.parens.halalscript"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.halalscript"
        }
      ]
    },
    "identifier": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
      "name": "variable.other.halalscript"
    }
  }
}
