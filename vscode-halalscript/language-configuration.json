{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["(", ")"],
    ["yalla", "khalas"]
  ],
  "colorizedBracketPairs": [
    ["{", "}"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*|[0-9]+|[\\u0660-\\u0669]+",
  "indentationRules": {
    "increaseIndentPattern": "^.*(\\byalla|\\{)\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(khalas\\b|\\})"
  },
  "onEnterRules": [
    {
      "beforeText": "^.*(\\byalla|\\{)\\s*(#.*)?$",
      "action": { "indent": "indent" }
    }
  ]
}
